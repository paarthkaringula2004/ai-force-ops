# Variable names only. Put real secrets in the ignored .env locally or the hosting secret store.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional Teams fallback. Admins can instead save encrypted app settings in Meeting Rooms.
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
# Must match a registered Microsoft Entra Web redirect URI.
TEAMS_REDIRECT_URI=http://localhost:3000/api/teams/callback
# Google Cloud OAuth client, application type: Web application.
# Local redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
# Admin action interpreter; use selected to follow the Playground answer model.
OPENAI_ADMIN_ROUTER_MODEL=gpt-4.1-mini
# Optional: personal leave interpreter model. Blank uses the selected Playground model.
OPENAI_EMPLOYEE_ROUTER_MODEL=
NEXT_PUBLIC_AIFORCE_URL=http://localhost:3000
# Optional extra request protection
ARCJET_KEY=
# Set true only after approved accounts have been created
AUTH_DISABLE_SIGNUP=false
# eAssist connections and shared background worker (also performs ePACE retention)
EASSIST_ALLOWED_ORIGINS=https://eassist-alertmanager.onrender.com,https://eassist-prometheus.onrender.com,https://semaphore-hgyh.onrender.com
EASSIST_WORKER_TOKEN=
EASSIST_APP_URL=http://localhost:3000
# ePACE per-account controls. Daily windows reset at midnight UTC.
EPACE_REQUESTS_PER_MINUTE=12
EPACE_REQUESTS_PER_DAY=200
EPACE_DAILY_TOKEN_LIMIT=500000
EPACE_REQUIRE_SAFETY=true
EPACE_BLOCK_FLAGGED=true
# Security scans: fixed approved origin; worker runs independently from Next.js.
SECURITY_SCAN_TARGET_URL=http://localhost:3000
SECURITY_SCAN_APP_URL=http://localhost:3000
SECURITY_SCAN_WORKER_TOKEN=
# Optional source checkout on the worker; defaults to its working directory.
SECURITY_SCAN_SOURCE_DIR=
# Default assistant uses database-backed workflow responses without paid AI calls.
REVIEW_CHAT_ENABLE_PAID_AI=true
# Master switch above controls ALL paid Review Center replies, including Manager and natural wording.
# The natural wording switch can additionally disable rewriting; it never overrides a false master switch.
# Natural wording for verified operational/security answers; requires OPENAI_API_KEY.
# Uses API tokens. Set false to keep the local server wording.
REVIEW_CHAT_NATURAL_AI=true
REVIEW_CHAT_MODEL=gpt-4.1-mini
VULNERABILITY_ENABLE_PAID_AI=false

# Transactional email: keep real credentials out of version control.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Random 32-byte hex key. Preserve it while queued encrypted messages exist.
MAIL_ENCRYPTION_KEY=
# Independent internal delivery-worker bearer secret, at least 32 characters.
MAIL_WORKER_TOKEN=

# Google Meet calendar connection (or configure encrypted credentials in Meeting Rooms).
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
# Must exactly match a Google Web OAuth authorised redirect URI.
GOOGLE_MEET_REDIRECT_URI=http://localhost:3000/api/google-meet/callback
